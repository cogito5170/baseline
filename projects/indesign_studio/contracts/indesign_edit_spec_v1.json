{
  "$id": "urn:ids:indesign_edit_spec:1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "document": {
      "type": "object",
      "properties": {
        "document_id": { "type": "string" },
        "expected_revision": { "type": "integer" }
      },
      "required": ["document_id", "expected_revision"]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op_id": { "type": "string" },
          "op": { "type": "string", "enum": ["create_text_frame", "add_page", "place_image", "set_text", "apply_style", "move_item"] },
          "page_index": { "type": "integer" },
          "bounds_pt": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "text": { "type": "string" },
          "paragraph_style": { "type": ["string", "null"] },
          "asset_id": { "type": "string" },
          "content_change_authorized": { "type": "boolean" }
        },
        "required": ["op_id", "op", "page_index"],
        "additionalProperties": false
      }
    }
  },
  "required": ["document", "operations"]
}
