{
  "$id": "urn:ids:indesign_validation_report:1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "structural_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "op_id": { "type": "string" },
          "item_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "evidence": { "type": "string" }
        },
        "required": ["id", "severity", "evidence"]
      }
    },
    "visual_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "op_id": { "type": "string" },
          "item_id": { "type": "string" },
          "severity": { "type": "string", "enum": ["info", "warning", "error"] },
          "evidence": { "type": "string" }
        },
        "required": ["id", "severity", "evidence"]
      }
    }
  },
  "required": ["structural_findings", "visual_findings"]
}
