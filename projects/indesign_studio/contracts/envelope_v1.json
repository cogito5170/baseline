{
  "$id": "urn:ids:envelope:1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string" },
    "message_id": { "type": "string" },
    "job_id": { "type": "string" },
    "correlation_id": { "type": "string" },
    "timestamp": { "type": "string" },
    "status": { "type": "string", "enum": ["ok", "error", "pending"] },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "path": { "type": "string" }
        },
        "required": ["code", "message"]
      }
    },
    "payload_schema": { "type": "string" },
    "payload": { "type": "object" }
  },
  "required": ["schema_version", "message_id", "job_id", "timestamp", "status", "payload_schema", "payload"]
}
