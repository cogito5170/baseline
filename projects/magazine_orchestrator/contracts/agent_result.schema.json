{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magorch:agent_result:1",
  "title": "agent_result/1 — what the orchestrator records for one task. 'completed' means the work finished; schema validation, content review and approval are separate fields.",
  "type": "object",
  "required": ["schema", "task_id", "status", "outputs", "issues", "unresolved_questions", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agent_result/1"},
    "task_id": {"$ref": "urn:magorch:common:1#/$defs/task_id"},
    "status": {"enum": ["completed", "failed", "timed_out", "cancelled", "invalid_output"]},
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "version", "schema", "validation_status"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": {"$ref": "urn:magorch:common:1#/$defs/artifact_id"},
          "version": {"$ref": "urn:magorch:common:1#/$defs/version"},
          "schema": {"$ref": "urn:magorch:common:1#/$defs/schema_name"},
          "validation_status": {"enum": ["passed", "failed", "not_applicable"]},
          "review_status": {"enum": ["not_reviewed", "passed", "failed"], "default": "not_reviewed"},
          "approval_status": {"$ref": "urn:magorch:common:1#/$defs/approval_status"}
        }
      }
    },
    "issues": {"type": "array", "items": {"$ref": "urn:magorch:common:1#/$defs/issue"}},
    "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "validation_errors": {"type": "array", "items": {"type": "string"}},
    "failure_reason": {"type": ["string", "null"]},
    "provenance": {"$ref": "urn:magorch:common:1#/$defs/provenance"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "completed"}}},
     "then": {"properties": {"outputs": {"items": {"properties": {"validation_status": {"enum": ["passed", "not_applicable"]}}}}}}},
    {"if": {"properties": {"status": {"enum": ["failed", "timed_out", "invalid_output"]}}},
     "then": {"required": ["failure_reason"], "properties": {"failure_reason": {"type": "string", "minLength": 1}}}}
  ]
}
