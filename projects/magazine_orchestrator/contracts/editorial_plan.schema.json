{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magorch:editorial_plan:1",
  "title": "editorial_plan/1 — concept, sections, article briefs, page plan and table of contents",
  "type": "object",
  "required": ["schema", "artifact_id", "version", "derived_from", "issue_title", "concept", "angle", "sections",
               "articles", "page_plan", "toc", "approval"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "editorial_plan/1"},
    "artifact_id": {"$ref": "urn:magorch:common:1#/$defs/artifact_id"},
    "version": {"$ref": "urn:magorch:common:1#/$defs/version"},
    "derived_from": {"$ref": "urn:magorch:common:1#/$defs/bound_ref", "description": "the creative_brief version used"},
    "issue_title": {"type": "string", "minLength": 1},
    "masthead": {"type": "string"},
    "concept": {"type": "string", "minLength": 1},
    "angle": {"type": "string", "minLength": 1},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "name", "purpose"],
        "additionalProperties": false,
        "properties": {
          "section_id": {"type": "string", "pattern": "^SEC-[A-Z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["article_id", "type", "section_id", "working_title", "brief", "content_nature", "fiction_label",
                     "needs_research", "pages", "word_target", "visual_needs"],
        "additionalProperties": false,
        "properties": {
          "article_id": {"$ref": "urn:magorch:common:1#/$defs/artifact_id"},
          "type": {"enum": ["cover", "contents", "editor_letter", "feature", "data_story", "interview", "essay",
                            "fiction", "portfolio", "colophon"]},
          "section_id": {"type": "string", "pattern": "^SEC-[A-Z0-9-]+$"},
          "working_title": {"type": "string", "minLength": 1},
          "brief": {"type": "string", "minLength": 1},
          "content_nature": {"enum": ["factual", "editorial", "creative", "mixed"],
                             "description": "factual = every factual claim needs a source; creative = invented content, must be labelled"},
          "fiction_label": {"type": ["string", "null"], "description": "reader-facing label printed on the page; required for creative content"},
          "needs_research": {"type": "boolean"},
          "pages": {"type": "integer", "minimum": 1},
          "word_target": {"type": ["integer", "null"], "minimum": 0},
          "visual_needs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["need_id", "kind", "description"],
              "additionalProperties": false,
              "properties": {
                "need_id": {"type": "string", "pattern": "^VN-[A-Z0-9-]+$"},
                "kind": {"enum": ["image", "chart", "diagram"]},
                "description": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "allOf": [
          {"if": {"properties": {"content_nature": {"const": "creative"}}},
           "then": {"properties": {"fiction_label": {"type": "string", "minLength": 1}}}},
          {"if": {"properties": {"content_nature": {"const": "factual"}}},
           "then": {"properties": {"needs_research": {"const": true}}}}
        ]
      }
    },
    "page_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page", "article_id", "template_hint"],
        "additionalProperties": false,
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "article_id": {"$ref": "urn:magorch:common:1#/$defs/artifact_id"},
          "template_hint": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    },
    "toc": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "page", "article_id"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "page": {"type": "integer", "minimum": 1},
          "article_id": {"$ref": "urn:magorch:common:1#/$defs/artifact_id"}
        }
      }
    },
    "approval": {"$ref": "urn:magorch:common:1#/$defs/approval"}
  }
}
