{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magorch:agent_task:1",
  "title": "agent_task/1 — one unit of work dispatched by the orchestrator to one agent role",
  "type": "object",
  "required": ["schema", "task_id", "project_id", "agent_role", "objective", "inputs", "instructions",
               "output_contract", "dependencies", "acceptance_criteria", "constraints", "status"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agent_task/1"},
    "task_id": {"$ref": "urn:magorch:common:1#/$defs/task_id"},
    "project_id": {"$ref": "urn:magorch:common:1#/$defs/project_id"},
    "agent_role": {"$ref": "urn:magorch:common:1#/$defs/agent_role"},
    "objective": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"$ref": "urn:magorch:common:1#/$defs/artifact_ref"}},
    "instructions": {
      "type": "object",
      "required": ["required_actions", "forbidden_actions"],
      "additionalProperties": false,
      "properties": {
        "required_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "context": {"type": "string", "description": "concise task context; never whole articles or project history"}
      }
    },
    "output_contract": {
      "type": "object",
      "required": ["schema", "artifact_type"],
      "additionalProperties": false,
      "properties": {
        "schema": {"$ref": "urn:magorch:common:1#/$defs/schema_name"},
        "artifact_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "artifact_ids": {"type": "array", "items": {"$ref": "urn:magorch:common:1#/$defs/artifact_id"},
                         "description": "ids the result must produce (exactly these) when given"}
      }
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "urn:magorch:common:1#/$defs/task_id"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "constraints": {
      "type": "object",
      "required": ["max_attempts", "timeout_seconds", "revision_limit"],
      "additionalProperties": false,
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "revision_limit": {"type": "integer", "minimum": 0},
        "on_upstream_change": {"enum": ["rerun", "revalidate"], "default": "rerun"}
      }
    },
    "status": {"enum": ["pending", "ready", "running", "succeeded", "failed", "timed_out", "blocked", "cancelled", "stale"]},
    "attempt": {"type": "integer", "minimum": 1},
    "repair_context": {
      "type": "object",
      "required": ["errors"],
      "additionalProperties": false,
      "properties": {"errors": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "revision_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "message"],
        "additionalProperties": false,
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "recommended_action": {"type": "string"},
          "report_id": {"type": "string"}
        }
      }
    },
    "idempotency_key": {"$ref": "urn:magorch:common:1#/$defs/sha256"},
    "created_at": {"$ref": "urn:magorch:common:1#/$defs/timestamp"}
  }
}
