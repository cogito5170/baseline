{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magorch:style_specification:1",
  "title": "style_specification/1 — a primary archetype plus independently configurable visual attributes",
  "type": "object",
  "required": ["schema", "artifact_id", "version", "derived_from", "classification", "visual_attributes",
               "design_constraints", "conflicts", "approval"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "style_specification/1"},
    "artifact_id": {"$ref": "urn:magorch:common:1#/$defs/artifact_id"},
    "version": {"$ref": "urn:magorch:common:1#/$defs/version"},
    "derived_from": {"$ref": "urn:magorch:common:1#/$defs/bound_ref", "description": "the creative_brief version used"},
    "classification": {
      "type": "object",
      "required": ["primary_archetype", "secondary_influences", "confidence", "confidence_method", "rationale"],
      "additionalProperties": false,
      "properties": {
        "primary_archetype": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "secondary_influences": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1,
                       "description": "classifier estimate, not a quality score; null unless confidence_method says how it was obtained"},
        "confidence_method": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"confidence": {"type": "number"}}},
      "then": {"properties": {"confidence_method": {"type": "string", "minLength": 1}}}
    },
    "visual_attributes": {
      "type": "object",
      "required": ["mood", "layout", "typography", "color", "imagery", "information_density", "motifs"],
      "additionalProperties": false,
      "properties": {
        "mood": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "layout": {
          "type": "object",
          "required": ["type", "symmetry", "whitespace", "image_usage"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["modular_grid", "manuscript", "column_grid", "hierarchical", "freeform"]},
            "symmetry": {"enum": ["symmetric", "asymmetric", "mixed"]},
            "whitespace": {"enum": ["tight", "moderate", "generous"]},
            "image_usage": {"enum": ["none", "spot", "selective_full_bleed", "image_led"]}
          }
        },
        "typography": {
          "type": "object",
          "required": ["headline", "body", "max_font_families"],
          "additionalProperties": false,
          "properties": {
            "headline": {"type": "string"},
            "body": {"type": "string"},
            "data": {"type": "string"},
            "accent": {"type": "string"},
            "max_font_families": {"type": "integer", "minimum": 1, "maximum": 4}
          }
        },
        "color": {
          "type": "object",
          "required": ["base", "accent", "usage"],
          "additionalProperties": false,
          "properties": {
            "base": {"type": "array", "minItems": 1, "items": {"$ref": "urn:magorch:common:1#/$defs/hex_color"}},
            "accent": {"type": "array", "items": {"$ref": "urn:magorch:common:1#/$defs/hex_color"}},
            "usage": {"type": "string"}
          }
        },
        "imagery": {
          "type": "object",
          "required": ["preferred", "avoid"],
          "additionalProperties": false,
          "properties": {
            "preferred": {"type": "array", "items": {"type": "string"}},
            "avoid": {"type": "array", "items": {"type": "string"}}
          }
        },
        "information_density": {"enum": ["sparse", "balanced", "dense"]},
        "motifs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "design_constraints": {
      "type": "object",
      "required": ["mandatory", "preferred", "prohibited"],
      "additionalProperties": false,
      "properties": {
        "mandatory": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "preferred": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["between", "resolution"],
        "additionalProperties": false,
        "properties": {"between": {"type": "array", "minItems": 2, "items": {"type": "string"}}, "resolution": {"type": "string"}}
      }
    },
    "reference_publications": {
      "type": "array",
      "description": "a publication name is never a full spec: each entry says which attribute it informs",
      "items": {
        "type": "object",
        "required": ["name", "informs"],
        "additionalProperties": false,
        "properties": {"name": {"type": "string"}, "informs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
      }
    },
    "approval": {"$ref": "urn:magorch:common:1#/$defs/approval"}
  }
}
