{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:magorch:publication_manifest:1",
  "title": "publication_manifest/1 — what was published, from exactly which artifact versions, and how to reproduce it",
  "type": "object",
  "required": ["schema", "publication_id", "project_id", "status", "format", "outputs", "qa_report", "inputs",
               "renderer", "created_at", "reproduce"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "publication_manifest/1"},
    "publication_id": {"type": "string", "pattern": "^PUB-[0-9]{3,}$"},
    "project_id": {"$ref": "urn:magorch:common:1#/$defs/project_id"},
    "status": {"enum": ["published", "blocked"]},
    "format": {"enum": ["pdf", "html"]},
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "version", "path", "sha256", "media_type", "pages"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": {"$ref": "urn:magorch:common:1#/$defs/artifact_id"},
          "version": {"$ref": "urn:magorch:common:1#/$defs/version"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "urn:magorch:common:1#/$defs/sha256"},
          "media_type": {"type": "string"},
          "pages": {"type": ["integer", "null"], "minimum": 1}
        }
      }
    },
    "qa_report": {
      "type": "object",
      "required": ["report_id", "publication_decision"],
      "additionalProperties": false,
      "properties": {"report_id": {"type": "string"}, "publication_decision": {"enum": ["approved", "blocked"]}}
    },
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "urn:magorch:common:1#/$defs/bound_ref"}},
    "renderer": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "version": {"type": ["string", "null"]}}
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent_role", "provider", "model_id", "verified"],
        "additionalProperties": false,
        "properties": {
          "agent_role": {"$ref": "urn:magorch:common:1#/$defs/agent_role"},
          "provider": {"type": "string"},
          "model_id": {"type": ["string", "null"]},
          "verified": {"type": "boolean", "description": "false for mock/scripted or untested integrations"}
        }
      }
    },
    "created_at": {"$ref": "urn:magorch:common:1#/$defs/timestamp"},
    "reproduce": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {"command": {"type": "string", "minLength": 1}, "note": {"type": "string"}}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "published"}}},
     "then": {"properties": {"qa_report": {"properties": {"publication_decision": {"const": "approved"}}}}}}
  ]
}
